{
  "name": "@davidsneighbour/vale-config",
  "description": "This repository contains a custom Vale configuration, styles, and dictionary files for writing and linting text the @davidsneighbour way.",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/vale-config.git"
  },
  "author": "Patrick Kollitsch <patrick@davids-neighbour.com>",
  "bugs": {
    "url": "https://github.com/davidsneighbour/vale-config/issues"
  },
  "homepage": "https://github.com/davidsneighbour/vale-config#readme",
  "keywords": [
    "vale",
    "linter",
    "vale-style"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@dnbhq/biome-config": "0.2.7",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@dnbhq/release-config": "1.1.3",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.4.1",
    "release-it": "21.0.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build:zip": "./scripts/build-release-zip.sh",
    "check": "npm run format:check && npm run lint && npm run validate && npm run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "npm run lint:code && npm run lint:markdown",
    "lint:code": "biome lint .",
    "lint:code:fix": "biome lint --write .",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"*.md\" \"!CHANGELOG.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"*.md\" \"!CHANGELOG.md\"",
    "postinstall": "npm run postinstall:biome && npm run sync:vale",
    "postinstall:biome": "biome migrate --write",
    "release": "release-it --config .release-it.ts --ci",
    "release:dry": "release-it --config .release-it.ts --dry-run",
    "release:force": "release-it --config .release-it.ts --ci --no-increment",
    "release:major": "release-it --config .release-it.ts --ci --increment=major",
    "release:minor": "release-it --config .release-it.ts --ci --increment=minor",
    "release:patch": "release-it --config .release-it.ts --ci --increment=patch",
    "renovate:validate": "renovate-config-validator .github/renovate.json5",
    "sync:vale": "vale sync",
    "test": "npm run test:unit && npm run test:vale && npm run test:package",
    "test:package": "./scripts/test-package.sh",
    "test:unit": "vitest --run",
    "test:vale": "./scripts/test-vale.sh",
    "validate": "npm run validate:types",
    "validate:types": "tsc --noEmit"
  },
  "main": "index.js",
  "type": "module"
}
